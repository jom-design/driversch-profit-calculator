{
  "name": "driver-profit-calculator",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test:assistant": "node --experimental-strip-types --test tests/assistant/*.test.mjs",
    "test": "npm run test:assistant && npm run test:e2e",
    "test:e2e": "node tests/e2e/inbox-persistence.mjs && node tests/e2e/native-voice-bridge.mjs && node tests/e2e/native-notification-sync.mjs && node tests/e2e/input-compat.mjs && node tests/e2e/layout-matrix.mjs"
  },
  "dependencies": {
    "idb": "^8.0.2",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tesseract.js": "^5.1.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "axe-core": "4.10.3",
    "fake-indexeddb": "6.2.4",
    "playwright": "1.52.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
